<p style="margin:0 0 16px 0;">
	Hi {{employeeName}}! An employee account has been created for you under <b>{{ownerName}}</b>'s Social Prices
	account.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
	style="background-color:#f7f9f8; border-radius:8px; margin-bottom:20px;">
	<tr>
		<td style="padding:16px 20px; font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333333;">
			<div style="margin-bottom:8px;"><b>Username:</b> {{username}}</div>
			<div><b>Temporary Password:</b> {{password}}</div>
		</td>
	</tr>
</table>

<p style="margin:0 0 8px 0;">
	Use the confirmation code below to complete your sign in:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
	<tr>
		<td align="center" style="padding:8px 0 20px 0;">
			<div
				style="display:inline-block; padding:12px 28px; background-color:#eaf4ee; border-radius:8px; font-family:Arial, Helvetica, sans-serif; font-size:26px; font-weight:bold; letter-spacing:4px; color:#1f6b46;">
				{{code}}
			</div>
		</td>
	</tr>
</table>

<p style="margin:0; color:#777777; font-size:13px;">
	For security, we recommend changing your temporary password after signing in.
</p>
