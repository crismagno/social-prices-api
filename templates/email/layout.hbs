<!DOCTYPE html>

<html lang="en">

<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta charset="UTF-8" />
	<title>{{title}}</title>

	<style type="text/css">
		body {
			font-family: Arial, Helvetica, sans-serif;
		}

		a {
			color: #2f7a55;
		}
	</style>
</head>

<body style="margin:0; padding:0; background-color:#f2f5f3;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f5f3;">
		<tr>
			<td align="center" style="padding:32px 16px;">
				<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
					style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden;">

					<!-- Title -->
					<tr>
						<td align="center" style="padding:32px 32px 8px 32px;">
							<h1 style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:22px; line-height:28px; color:#1f3d2f;">
								{{title}}
							</h1>
						</td>
					</tr>

					<!-- Hero image -->
					<tr>
						<td align="center" style="padding:8px 12px 16px 12px;">
							<img src="{{heroImageSrc}}" alt="{{heroImageAlt}}" width="576" height="576"
								style="display:block; width:100%; max-width:576px; height:auto; margin:0 auto; border:0;" />
						</td>
					</tr>

					<!-- Body (per-email content) -->
					<tr>
						<td style="padding:8px 32px 32px 32px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:22px; color:#333333;">
							{{{body}}}
						</td>
					</tr>

					<!-- Divider -->
					<tr>
						<td style="padding:0 32px;">
							<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
								<tr>
									<td style="border-top:1px solid #e6e9e7; font-size:0; line-height:0;">&nbsp;</td>
								</tr>
							</table>
						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td align="center" style="padding:24px 32px 32px 32px;">
							<img src="{{logoSrc}}" alt="{{appName}}" width="40" height="40"
								style="display:block; width:40px; height:40px; border:0; margin:0 auto 8px auto;" />

							<div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; color:#1f3d2f;">
								{{appName}}
							</div>

							<div style="font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#9aa1ac; margin-top:4px;">
								{{tagline}}
							</div>
						</td>
					</tr>

				</table>
			</td>
		</tr>
	</table>
</body>

</html>
