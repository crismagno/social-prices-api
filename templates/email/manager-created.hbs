<p style="margin:0 0 16px 0;">
	Hi {{managerName}}! A manager account has been created for you on Social Prices, with the <b>{{levelLabel}}</b>
	level.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
	style="background-color:#f7f9f8; border-radius:8px; margin-bottom:20px;">
	<tr>
		<td style="padding:16px 20px; font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333333;">
			<div style="margin-bottom:8px;"><b>Email:</b> {{email}}</div>
			<div><b>Temporary Password:</b> {{password}}</div>
		</td>
	</tr>
</table>

<p style="margin:0; color:#777777; font-size:13px;">
	For security, use the "forgot my password" link on the manager sign in page to set a password only you know.
</p>
